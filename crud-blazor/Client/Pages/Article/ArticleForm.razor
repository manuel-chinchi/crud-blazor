<EditForm Model="@Article" OnValidSubmit="OnValidSubmit">
    <div class="form-group">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="@Article.Name"></InputText>
    </div>
    <div class="form-group">
        <label>Category</label>
        <InputSelect class="form-control" @bind-Value="@Article.CategoryId">
            @if (Categories != null)
            {
                @foreach (var category in Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
        </InputSelect>
    </div>
    <br />
    <button type="submit" class="btn btn-success"><span class="oi oi-check mr-2"></span>Accept</button>
    <a class="btn btn-secondary" href="@UrlBtnBack"><span class="oi oi-chevron-left mr-2"></span>Back</a>
</EditForm>

@code {
    [Parameter] public Article Article { get; set; } = new Article();
    [Parameter] public Category[] Categories { get; set; }
    [Parameter] public string UrlBtnBack { get; set; } = "articles";
    [Parameter] public EventCallback OnValidSubmit { get; set; }
}