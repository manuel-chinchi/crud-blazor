@page "/articles"

@inject HttpClient Http
@inject SweetAlertService Swal
@inject IJSRuntime JS
@using crud_blazor.Client.Pages.Common

<h3>Articles</h3>
<br />
<TableToolbar TextBtnAdd="New" TextBtnExport="Download"
              SearchText="@searchText" OnSearchItem="SearchArticle"
              ExportToCSV="ExportToCSV" ExportToExcel="ExportToExcel" ExportToPDF="ExportToPDF"
              UrlBtnAdd="article-create" />
<br />

@if (articles == null)
{
    <p>Loading items...</p>
}
else if (articles.Length == 0)
{
    <p>No items</p>
}
else
{
    <TableData TItem="Article" Items="articles">
        <TableHeader>
            <th>Id</th>
            <th>Name</th>
            <th>Category</th>
            <th class="text-center">Actions</th>
        </TableHeader>
        <RowTemplate Context="article">
            <td>@article.Id</td>
            <td>@article.Name</td>
            <td>@article.Category.Name</td>
            <td class="text-center">
                <a class="btn btn-success" href="article-edit/@article.Id"><span class="oi oi-pencil mr-2"></span>Edit</a>
                <button class="btn btn-danger" @onclick="@(() => DeleteArticle(@article.Id))">
                    <span class="oi oi-delete mr-2"></span>Delete
                </button>
            </td>
        </RowTemplate>
    </TableData>
}



@code {
    Article[] articles;
    private string searchText;

    protected override async Task OnInitializedAsync()
    {
        await LoadArticles();
    }

    async Task LoadArticles()
    {
        articles = await Http.GetFromJsonAsync<Article[]>("Article");
    }

    async Task DeleteArticle(int id)
    {
        Article a = await Http.GetFromJsonAsync<Article>($"Article/{id}");
        var result = await Swal.FireAsync(new SweetAlertOptions()
        {
            Title = "Confirm",
            Text = $"Are you sure you want to delete the article \"{a.Name}\"?",
            Icon = SweetAlertIcon.Warning,
            //ConfirmButtonText = "Yes",
            //CancelButtonText = "No",
            ConfirmButtonText = @"
                <div style=""min-width: 75px;"">
                    <span style=""font-size: 18px; top: 2px;"" class='oi oi-check mr-2'></span>Yes
                </div>
            ",
            CancelButtonText = @"
                <div style=""min-width: 75px;"">
                    <span class='oi oi-x mr-2'></span>No
                </div>
            ",
            ShowCancelButton = true
        });

        if (!string.IsNullOrEmpty(result.Value))
        {
            await Http.DeleteAsync($"Article/{id}");
            await LoadArticles();
        }
    }

    public async Task SearchArticle(string searchText)
    {
        if (!string.IsNullOrEmpty(searchText))
        {
            searchText = searchText.Trim().ToLower();

            await LoadArticles();

            searchText = searchText.Trim();
            articles = articles
                .Where
                (a =>
                    a.Name.ToLower().Contains(searchText) ||
                    a.Category.Name.ToLower().Contains(searchText)
                ).ToArray();
        }
        else
        {
            await LoadArticles();
        }
        await Task.CompletedTask;
    }

    async Task<string> GetTimeStamp()
    {
        var timestamp = await JS.InvokeAsync<string>("getLocalTimestamp");
        return timestamp;
    }

    async void ExportToCSV()
    {
        var response = await Http.PostAsJsonAsync<Article[]>("export/articles/csv", articles);
        var timestamp = await GetTimeStamp();

        if (response.IsSuccessStatusCode)
        {
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeAsync<object>("saveAsFile", $"Articles_{timestamp}.csv", bytes);
        }
    }

    async void ExportToExcel()
    {
        var result = await Http.PostAsJsonAsync<Article[]>("export/articles/excel", articles);
        var timestamp = await GetTimeStamp();

        if (result.IsSuccessStatusCode)
        {
            var bytes = await result.Content.ReadAsByteArrayAsync();
            await JS.InvokeAsync<object>("saveAsFile", $"Articles_{timestamp}.xlsx", bytes);
        }
    }

    async void ExportToPDF()
    {
        var result = await Http.PostAsJsonAsync<Article[]>("export/articles/pdf", articles);
        var timestamp = await GetTimeStamp();

        if (result.IsSuccessStatusCode)
        {
            var bytes = await result.Content.ReadAsByteArrayAsync();
            await JS.InvokeAsync<object>("saveAsFile", $"Articles_{timestamp}.pdf", bytes);
        }
    }
}
