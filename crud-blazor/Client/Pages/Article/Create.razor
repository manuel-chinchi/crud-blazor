@page "/article-create"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>New article</h3>
<br />

@*<a class="btn btn-secondary" href="articles"><span class="oi oi-chevron-left mr-2"></span>Back</a>
<div><br /></div>*@

<ArticleForm Article="article" Categories="categories" OnValidSubmit="CreateArticle" />

@code {
    public Article article { get; set; } = new Article();
    public Category[] categories { get; set; }
    public string categoryId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        categories = await Http.GetFromJsonAsync<Category[]>("Category");
        article.CategoryId = "1";
    }

    async Task CreateArticle()
    {
        article.Category = await Http.GetFromJsonAsync<Category>($"Category/{Convert.ToInt32(article.CategoryId)}");
        await Http.PostAsJsonAsync("Article", article);
        Navigation.NavigateTo("articles");
    }
}
