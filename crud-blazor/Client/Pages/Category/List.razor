@page "/categories"

@inject HttpClient Http
@inject SweetAlertService Swal
@inject IJSRuntime JS
@using crud_blazor.Client.Pages.Common

<h3>Categories</h3>
<br />
<TableToolbar TextBtnAdd="New" TextBtnExport="Download" 
              SearchText="@searchText" OnSearchItem="SearchCategory"
              ExportToCSV="ExportToCSV" ExportToExcel="ExportToExcel" ExportToPDF="ExportToPDF" UrlBtnAdd="category-create"/>
<br />

@if (categories == null)
{
    <p>Loading items...</p>
}
else if (categories.Length == 0)
{
    <p>No items</p>
}
else
{
    <TableData TItem="Category" Items="categories">
        <TableHeader>
            <th>Id</th>
            <th>Name</th>
            <th class="text-center">Actions</th>
        </TableHeader>
        <RowTemplate Context="category">
            <td>@category.Id</td>
            <td>@category.Name</td>
            <td class="text-center">
                <button class="btn btn-danger" @onclick="@(() => DeleteCategory(@category.Id))">
                    <span class="oi oi-delete mr-2"></span>Delete
                </button>
            </td>
        </RowTemplate>
    </TableData>
}



@code {
    Category[] categories;
    private string searchText;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    async Task LoadCategories()
    {
        categories = await Http.GetFromJsonAsync<Category[]>("Category");
    }

    async Task DeleteCategory(int id)
    {
        var c = await Http.GetFromJsonAsync<Category>($"Category/{id}");
        var result = await Swal.FireAsync(new SweetAlertOptions()
        {
            Title = "Confirm",
            Text = $"Are you sure you want to delete the category \"{c.Name}\"?",
            Icon = SweetAlertIcon.Warning,
            //ConfirmButtonText = "Yes",
            //CancelButtonText = "No",
            ConfirmButtonText = @"
                <div style=""min-width: 75px;"">
                    <span style=""font-size: 18px; top: 2px;"" class='oi oi-check mr-2'></span>Yes
                </div>
            ",
            CancelButtonText = @"
                <div style=""min-width: 75px;"">
                    <span class='oi oi-x mr-2'></span>No
                </div>
            ",
            ShowCancelButton = true
        });

        if (!string.IsNullOrEmpty(result.Value))
        {
            await Http.DeleteAsync($"Category/{id}");
            await LoadCategories();
        }
    }

    public async Task SearchCategory(string searchText)
    {
        if (!string.IsNullOrEmpty(searchText))
        {
            searchText = searchText.Trim().ToLower();

            await LoadCategories();

            categories = categories
                .Where(c => !string.IsNullOrEmpty(c.Name)).ToArray();

            categories = categories
                .Where(c => c.Name.ToLower().Contains(searchText))
                .ToArray();
        }
        else
        {
            await LoadCategories();
        }

        await Task.CompletedTask;
    }

    async Task<string> GetTimeStamp()
    {
        var timestamp = await JS.InvokeAsync<string>("getLocalTimestamp");
        return timestamp;
    }

    async void ExportToCSV()
    {
        var result = await Http.PostAsJsonAsync<Category[]>("export/categories/csv", categories);
        var timestamp = await GetTimeStamp();

        if (result.IsSuccessStatusCode)
        {
            var bytes = await result.Content.ReadAsByteArrayAsync();
            await JS.InvokeAsync<object>("saveAsFile", $"Categories_{timestamp}.csv", bytes);
        }
    }

    async void ExportToExcel()
    {
        var result = await Http.PostAsJsonAsync<Category[]>("export/categories/excel", categories);
        var timestamp = await GetTimeStamp();

        if (result.IsSuccessStatusCode)
        {
            var bytes = await result.Content.ReadAsByteArrayAsync();
            await JS.InvokeAsync<object>("saveAsFile", $"Categories_{timestamp}.xlsx", bytes);
        }
    }

    async void ExportToPDF()
    {
        var result = await Http.PostAsJsonAsync<Category[]>("export/categories/pdf", categories);
        var timestamp = await GetTimeStamp();

        if (result.IsSuccessStatusCode)
        {
            var bytes = await result.Content.ReadAsByteArrayAsync();
            await JS.InvokeAsync<object>("saveAsFile", $"Categories_{timestamp}.pdf", bytes);
        }
    }
}
